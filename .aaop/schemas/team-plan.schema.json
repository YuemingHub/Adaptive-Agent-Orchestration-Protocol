{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaop.dev/schemas/team-plan.schema.json",
  "title": "AAOP Team Plan",
  "type": "object",
  "required": ["strategy", "agents"],
  "properties": {
    "strategy": {"enum": ["single-agent", "subagents", "agent-team", "sequential-role-isolation", "hybrid"]},
    "rationale": {"type": "string"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "objective", "responsibilities", "completion_criteria"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "objective": {"type": "string"},
          "responsibilities": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "skills": {"type": "array", "items": {"type": "string"}},
          "tools": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "completion_criteria": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
